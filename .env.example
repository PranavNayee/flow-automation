# Browser profile (Playwright will create this directory)
BROWSER_PROFILE_PATH=./playwright-state

# Rate limits (safety first!)
MAX_GENERATIONS_PER_HOUR=10
MAX_GENERATIONS_PER_DAY=50

# Retry settings
MAX_RETRIES=3
RETRY_DELAY_SECONDS=30

# LLM API for script generation (configure at least one - cheaper providers tried first)
# DeepSeek (cheapest, OpenAI-compatible) - https://platform.deepseek.com
# DEEPSEEK_API_KEY=your_deepseek_key_here

# Gemini (Google, has free tier) - https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key_here

# OpenAI (reliable, moderate cost) - https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here

# Anthropic Claude (premium) - https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Notifications (optional - Slack/Discord webhook)
# Get webhook URL from: Slack workspace settings or Discord channel integrations
# NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# YouTube API (optional - only if uploading)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.pickle

# Delays (in seconds) - randomized for human-like behavior
MIN_DELAY_BETWEEN_ACTIONS=2
MAX_DELAY_BETWEEN_ACTIONS=5
MIN_DELAY_BETWEEN_GENERATIONS=60
MAX_DELAY_BETWEEN_GENERATIONS=180

# Flow URL
FLOW_URL=https://labs.google/flow

# Database
DATABASE_PATH=./data/queue.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/flow_automation.log

# Credit tracking (optional - your plan's monthly limit)
MONTHLY_CREDIT_LIMIT=500
